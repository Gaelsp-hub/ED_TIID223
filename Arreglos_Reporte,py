numeros = [10, 20, 30, 40]

# Operaciones para obtener [10, 20, 95, 30, 40, 50, 67]
numeros.insert(2, 95)
numeros.extend([50, 67])

# 1. Imprime el arreglo completo
print("Arreglo completo:", numeros)

# 2. Imprime el número 95
print("Número 95:", numeros[2])

# 3. Imprime el número 67
print("Número 67:", numeros[6])

# 4. Indica qué posición ocupa cada uno
print(f"El número 95 ocupa el índice {numeros.index(95)} (Posición {numeros.index(95) + 1})")
